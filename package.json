{
  "name": "taiga-mcp",
  "version": "0.3.0",
  "description": "A read-only Model Context Protocol server for Taiga: ask an AI assistant about your projects, sprints, user stories, issues and epics.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.6.0"
  },
  "bin": {
    "taiga-mcp": "dist/index.js",
    "taiga-mcp-http": "dist/remote.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "start:http": "node dist/remote.js",
    "dev:http": "pnpm build && node --env-file=.env dist/remote.js",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fflate": "^0.8.3",
    "undici": "^6.29.1",
    "unpdf": "~1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
