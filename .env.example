# Copy to .env and fill in. Never commit .env.

# Address of the Taiga API host, without /api/v1.
# Taiga cloud: https://api.taiga.io   Self-hosted: usually the address you open Taiga at.
TAIGA_URL=

# Sign in with a username and password...
TAIGA_USERNAME=
TAIGA_PASSWORD=

# ...or with tokens you already have (leave the two lines above empty).
# TAIGA_TOKEN=
# TAIGA_REFRESH_TOKEN=

# Also let the AI create items, change them and comment, as this account. Off unless set.
# Nothing can be deleted either way.
# TAIGA_WRITE=true

# --- Only for the hosted server (pnpm start:http): many people, each signing in themselves ---
# TAIGA_URL above is the one Taiga people sign in to; the username, password and tokens above are not used.

# Let each person type the address of their own Taiga on the sign-in page (Taiga cloud, or a
# company's own). TAIGA_URL then only pre-fills that field, and may be left empty.
# ANY_TAIGA=true

# Offer each person, at sign-in, a box that lets their app create and change items. Off unless set.
# Turning it off again takes writing away from every connection at once.
# ALLOW_WRITES=true

# The address people reach the server at, without a path. http:// is accepted for localhost only.
# PUBLIC_URL=https://taiga-mcp.example.com

# A long random value that encrypts everything the server hands out: openssl rand -base64 48
# Changing it signs everyone out.
# MCP_SECRET=

# PORT=3000
